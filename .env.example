# Copy to .env before `make up`. Compose reads this file automatically.
# Every host, port, threshold and credential the system uses is named here.
# No literal for any of these appears anywhere in application code.

# ─── Runtime ──────────────────────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO

# ─── TimescaleDB ──────────────────────────────────────────────────────────
POSTGRES_USER=airsense
POSTGRES_PASSWORD=airsense
POSTGRES_DB=airsense
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── MQTT broker ──────────────────────────────────────────────────────────
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=airsense/telemetry

# ─── ingest-api ───────────────────────────────────────────────────────────
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000

# ─── device-simulator ─────────────────────────────────────────────────────
SIMULATOR_API_PORT=8001
SIMULATOR_PUBLISH_INTERVAL_SECONDS=1.0

# ─── dashboard ────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000

# ─── CRM sink selection ───────────────────────────────────────────────────
# "memory" backs the CRM panel served by this app and is what the live demo
# uses. Set to "hubspot" and supply a token to hit the real HubSpot API (P4).
TICKET_SINK=memory
# HUBSPOT_ACCESS_TOKEN=

# ─── Domain rule thresholds ───────────────────────────────────────────────
# See docs/domain-rules.md. Entry and exit are separated by a deadband; without
# the gap a score hovering on the line flaps between states.
WATCH_ENTER=0.50
WATCH_EXIT=0.40
ALERT_ENTER=0.75
ALERT_EXIT=0.65
SUSTAINED_SAMPLES=5

SEVERITY_MEDIUM_BAND=0.60
SEVERITY_HIGH_BAND=0.75
SEVERITY_CRITICAL_BAND=0.90
# Health index per sample above which a device is promoted one severity level.
FAST_DEGRADATION_PER_SAMPLE=0.008

TICKET_COOLDOWN_MINUTES=30
CONDITION_HISTORY_SAMPLES=20
